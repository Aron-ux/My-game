extends Sprite2D

# One-shot pixel sheet effect (generated by scripts/tools/enemy_pixel_art).
# Plays a single row left to right, optionally following a node, then frees itself.

const ART_PIXEL_SCALE := 0.375
const MAX_ACTIVE := 48

static var active_count := 0

var fps := 14.0
var follow: Node2D
var follow_offset := Vector2.ZERO
var elapsed := 0.0


static func spawn(parent: Node, sheet: Texture2D, columns: int, world_position: Vector2, options := {}) -> Node2D:
	if parent == null or sheet == null or active_count >= MAX_ACTIVE:
		return null
	var effect := new()
	effect.texture = sheet
	effect.hframes = columns
	effect.vframes = int(options.get("rows", 1))
	effect.frame = int(options.get("row", 0)) * columns
	effect.fps = float(options.get("fps", 14.0))
	effect.scale = Vector2.ONE * ART_PIXEL_SCALE * float(options.get("art_scale", 1.0))
	effect.z_index = int(options.get("z_index", 15))
	effect.follow = options.get("follow", null) as Node2D
	effect.follow_offset = options.get("offset", Vector2.ZERO)
	effect.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	effect.global_position = world_position + effect.follow_offset
	parent.add_child(effect)
	return effect


func _enter_tree() -> void:
	active_count += 1


func _exit_tree() -> void:
	active_count = maxi(0, active_count - 1)


func _process(delta: float) -> void:
	elapsed += delta
	var column := int(elapsed * fps)
	if column >= hframes:
		queue_free()
		return
	frame = (frame / hframes) * hframes + column
	if follow != null:
		if is_instance_valid(follow) and follow.is_inside_tree():
			global_position = follow.global_position + follow_offset
		else:
			follow = null
