[gd_scene format=3 uid="uid://bmwj3q55caggl"]

[sub_resource type="GDScript" id="GDScript_pann6"]
script/source = "extends Node2D

const LASER_COLOR := Color(39.0 / 255.0, 39.0 / 255.0, 39.0 / 255.0, 1.0)
const AURA_COLOR := Color(0.19, 0.05, 0.28, 0.28)
const CORE_LENGTH := 860.0

@onready var aura: Line2D = $Aura
@onready var body: Line2D = $Body
@onready var core: Line2D = $Core
@onready var origin_ring: Line2D = $OriginRing
@onready var end_ring: Line2D = $EndRing

var elapsed: float = 0.0


func _ready() -> void:
	_setup_line(aura, 34.0, AURA_COLOR)
	_setup_line(body, 18.0, Color(LASER_COLOR.r, LASER_COLOR.g, LASER_COLOR.b, 0.82))
	_setup_line(core, 6.0, Color(0.02, 0.02, 0.02, 1.0))
	_setup_ring(origin_ring, 34.0, Color(0.12, 0.04, 0.18, 0.88))
	_setup_ring(end_ring, 22.0, Color(0.12, 0.04, 0.18, 0.72))
	set_process(true)


func _process(delta: float) -> void:
	elapsed += delta
	var pulse: float = 0.5 + 0.5 * sin(elapsed * 7.5)
	aura.width = lerpf(28.0, 42.0, pulse)
	aura.default_color.a = lerpf(0.16, 0.34, pulse)
	body.width = lerpf(15.0, 21.0, pulse)
	core.default_color.a = lerpf(0.82, 1.0, pulse)
	origin_ring.rotation = elapsed * 1.6
	end_ring.rotation = -elapsed * 1.25
	origin_ring.scale = Vector2.ONE * lerpf(0.94, 1.08, pulse)
	end_ring.scale = Vector2.ONE * lerpf(0.9, 1.05, 1.0 - pulse)


func _setup_line(line: Line2D, width: float, color: Color) -> void:
	line.points = PackedVector2Array([Vector2.ZERO, Vector2(CORE_LENGTH, 0.0)])
	line.width = width
	line.default_color = color
	line.begin_cap_mode = Line2D.LINE_CAP_ROUND
	line.end_cap_mode = Line2D.LINE_CAP_ROUND


func _setup_ring(ring: Line2D, radius: float, color: Color) -> void:
	ring.closed = true
	ring.width = 4.0
	ring.default_color = color
	ring.points = _circle_points(radius, 32)


func _circle_points(radius: float, segments: int) -> PackedVector2Array:
	var points := PackedVector2Array()
	for index in range(max(3, segments)):
		points.append(Vector2.RIGHT.rotated(TAU * float(index) / float(segments)) * radius)
	return points
"

